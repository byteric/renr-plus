generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  riskReassessments RiskReassessment[] @relation("RiskReassessmentOrganization")
  reassessmentMeasures ReassessmentMeasure[] @relation("ReassessmentMeasureOrganization")
  actionTechnicalClosures ActionTechnicalClosure[] @relation("ActionTechnicalClosureOrganization")
  actionCorrectiveLinks ActionCorrectiveLink[] @relation("ActionCorrectiveLinkOrganization")
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  fiscalIdentifier String? @map("fiscal_identifier") @db.VarChar(32)
  timezone String @default("America/Sao_Paulo")
  isActive Boolean @default(true) @map("is_active")
  memberships Membership[]
  units Unit[]
  sectors Sector[]
  instrumentVersions InstrumentVersion[]
  instruments Instrument[]
  assessmentGroups AssessmentGroup[]
  diagnosticCycles DiagnosticCycle[]
  assessmentCycles AssessmentCycle[]
  consolidationPolicies ConsolidationPolicyVersion[]
  risks Risk[]
  riskEvaluations RiskEvaluation[]
  evaluationMethods EvaluationMethod[]
  evaluationMethodVersions EvaluationMethodVersion[]
  technicalRiskEvaluations TechnicalRiskEvaluation[]
  actions Action[]
  accessInvites AccessInvite[]
  accessHistory AccessHistory[]
  employees Employee[]
  actionEfficacyOpinions ActionEfficacyOpinion[]

  @@map("organizations")
}

enum Role {
  ADMIN
  READER
}

model User {
  riskReassessments RiskReassessment[] @relation("RiskReassessmentAuthor")
  actionTechnicalClosures ActionTechnicalClosure[] @relation("ActionTechnicalClosureAuthor")
  actionCorrectiveLinks ActionCorrectiveLink[] @relation("ActionCorrectiveLinkAuthor")
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  email String @unique @db.VarChar(254)
  passwordHash String @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships Membership[]
  sessions Session[]
  risksCreated Risk[] @relation("RiskCreator")
  risksUpdated Risk[] @relation("RiskUpdater")
  riskEvaluations RiskEvaluation[]
  actionsCreated Action[] @relation("ActionCreator")
  actionsUpdated Action[] @relation("ActionUpdater")
  actionRevisions ActionRevision[]
  evidenceCreated ActionEvidence[] @relation("EvidenceCreator")
  evidenceArchived ActionEvidence[] @relation("EvidenceArchiver")
  accessInvitesCreated AccessInvite[] @relation("AccessInviteCreator")
  accessHistorySubject AccessHistory[] @relation("AccessHistorySubject")
  accessHistoryActor AccessHistory[] @relation("AccessHistoryActor")
  assessmentSources AssessmentSource[]
  instrumentsPublished InstrumentVersion[] @relation("InstrumentPublisher")
  policiesPublished ConsolidationPolicyVersion[] @relation("PolicyPublisher")
  evaluationMethods EvaluationMethod[]
  methodVersionsCreated EvaluationMethodVersion[] @relation("EvaluationMethodCreator")
  methodVersionsPublished EvaluationMethodVersion[] @relation("EvaluationMethodPublisher")
  technicalRiskEvaluations TechnicalRiskEvaluation[]
  @@map("users")
  actionEfficacyOpinions ActionEfficacyOpinion[]
}

model Membership {
  uploadAttempts EvidenceUploadAttempt[]
  userId String @map("user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  role Role
  isActive Boolean @default(true) @map("is_active")
  version Int @default(1)
  capabilities Capability[] @default([])
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees Employee[]
  @@id([userId, organizationId])
  assignedActions Action[]
  @@index([organizationId])
  @@map("memberships")
}

enum Capability {
  EXECUTE_ASSIGNED_ACTIONS
  TECHNICAL_DECISIONS
}

model AccessInvite {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  email String @db.VarChar(254)
  name String @db.VarChar(120)
  role Role
  capabilities Capability[] @default([])
  tokenHash String @unique @map("token_hash") @db.Char(64)
  version Int @default(1)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  consumedAt DateTime? @map("consumed_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "access_invites_organization_id_fkey")
  creator User @relation("AccessInviteCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "access_invites_created_by_fkey")
  @@index([organizationId, createdAt, id])
  @@index([createdBy], map: "access_invites_created_by_idx")
  @@map("access_invites")
}

model AccessHistory {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  actorName String @map("actor_name") @db.VarChar(120)
  action String @db.VarChar(100)
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "access_history_organization_id_fkey")
  subject User? @relation("AccessHistorySubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "access_history_user_id_fkey")
  actor User @relation("AccessHistoryActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "access_history_actor_id_fkey")
  @@index([organizationId, createdAt, id])
  @@index([userId], map: "access_history_user_id_idx")
  @@index([actorId], map: "access_history_actor_id_idx")
  @@map("access_history")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId String @map("user_id") @db.Uuid
  activeOrganizationId String? @map("active_organization_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Unit {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(120)
  normalizedName String @map("normalized_name") @db.VarChar(120)
  code String? @db.VarChar(32)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id])
  sectors Sector[]
  employees Employee[]
  @@unique([organizationId, id])
  @@unique([organizationId, normalizedName])
  @@map("units")
}

model Sector {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  unitId String @map("unit_id") @db.Uuid
  name String @db.VarChar(120)
  normalizedName String @map("normalized_name") @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id])
  unit Unit @relation(fields: [unitId], references: [id])
  assessmentGroups AssessmentGroup[]
  employees Employee[]
  @@unique([organizationId, unitId, id])
  @@unique([organizationId, id])
  @@unique([unitId, normalizedName])
  @@index([organizationId])
  @@map("sectors")
}

enum DiagnosticQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ORDINAL_CHOICE
}

enum InstrumentUsageMode {
  DEMONSTRATION
  REAL
}

model Instrument {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(160)
  systemKey String? @map("system_key") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  versions InstrumentVersion[]
  @@unique([organizationId, id])
  @@unique([organizationId, systemKey])
  @@map("instruments")
}

enum DiagnosticCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

model InstrumentVersion {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  title String @db.VarChar(160)
  version Int
  status String @default("PUBLISHED") @db.VarChar(20)
  isDemo Boolean @default(true) @map("is_demo")
  instrumentId String @default(dbgenerated("NULL")) @map("instrument_id") @db.Uuid
  revision Int @default(1)
  description String @default("") @db.VarChar(2000)
  instructions String @default("") @db.VarChar(4000)
  usageMode InstrumentUsageMode @default(DEMONSTRATION) @map("usage_mode")
  approvalReference String? @map("approval_reference") @db.VarChar(1000)
  publishedAt DateTime? @map("published_at")
  publishedById String? @map("published_by_id") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  creationTransaction String @default(dbgenerated("txid_current()::text")) @map("creation_transaction")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instrument Instrument @relation(fields: [organizationId, instrumentId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "instrument_versions_instrument_fkey")
  questions DiagnosticQuestion[]
  cycles DiagnosticCycle[]
  assessmentCycles AssessmentCycle[]
  @@unique([organizationId, id])
  @@unique([instrumentId, version])
  @@map("instrument_versions")
  publishedBy User? @relation("InstrumentPublisher", fields: [publishedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model DiagnosticQuestion {
  id String @id @default(uuid()) @db.Uuid
  instrumentVersionId String @map("instrument_version_id") @db.Uuid
  label String @db.VarChar(400)
  type DiagnosticQuestionType
  required Boolean @default(true)
  position Int
  instrumentVersion InstrumentVersion @relation(fields: [instrumentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options QuestionOption[]
  answers ResponseAnswer[]
  assessmentAnswers AssessmentAnswer[]
  @@unique([instrumentVersionId, id])
  @@unique([instrumentVersionId, position])
  @@map("diagnostic_questions")
}

model QuestionOption {
  id String @id @default(uuid()) @db.Uuid
  instrumentVersionId String @map("instrument_version_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  label String @db.VarChar(200)
  position Int
  question DiagnosticQuestion @relation(fields: [instrumentVersionId, questionId], references: [instrumentVersionId, id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([questionId, position])
  @@index([instrumentVersionId, questionId])
  @@map("question_options")
}

model AssessmentGroup {
  name String @default("Grupo de avaliação") @db.VarChar(120)
  isActive Boolean @default(true) @map("is_active")
  version Int @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sectorId String @map("sector_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sector Sector @relation(fields: [organizationId, sectorId], references: [organizationId, id], onDelete: Restrict)
  cycleGroups CycleGroup[]
  assessmentCycles AssessmentCycle[]
  risks Risk[]
  @@unique([organizationId, id])
  @@unique([organizationId, sectorId])
  @@map("assessment_groups")
}

model DiagnosticCycle {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  instrumentVersionId String @map("instrument_version_id") @db.Uuid
  name String @db.VarChar(160)
  startsAt DateTime @map("starts_at")
  endsAt DateTime @map("ends_at")
  status DiagnosticCycleStatus @default(DRAFT)
  createdAt DateTime @default(now()) @map("created_at")
  closedAt DateTime? @map("closed_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  instrumentVersion InstrumentVersion @relation(fields: [organizationId, instrumentVersionId], references: [organizationId, id], onDelete: Restrict)
  groups CycleGroup[]
  invites ParticipationInvite[]
  responses DiagnosticResponse[]
  risks Risk[]
  @@unique([organizationId, id])
  @@unique([organizationId, id, instrumentVersionId])
  @@index([organizationId, createdAt])
  @@index([organizationId, instrumentVersionId])
  @@map("diagnostic_cycles")
}

model CycleGroup {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cycleId String @map("cycle_id") @db.Uuid
  assessmentGroupId String @map("assessment_group_id") @db.Uuid
  cycle DiagnosticCycle @relation(fields: [organizationId, cycleId], references: [organizationId, id], onDelete: Restrict)
  assessmentGroup AssessmentGroup @relation(fields: [organizationId, assessmentGroupId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, cycleId, assessmentGroupId])
  @@index([organizationId, cycleId])
  @@index([organizationId, assessmentGroupId])
  @@map("cycle_groups")
}

model ParticipationInvite {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cycleId String @map("cycle_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  cycle DiagnosticCycle @relation(fields: [organizationId, cycleId], references: [organizationId, id], onDelete: Restrict)
  @@index([organizationId, cycleId])
  @@map("participation_invites")
}

model DiagnosticResponse {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  cycleId String @map("cycle_id") @db.Uuid
  instrumentVersionId String @map("instrument_version_id") @db.Uuid
  submittedPeriod DateTime @map("submitted_period") @db.Date
  cycle DiagnosticCycle @relation(fields: [organizationId, cycleId, instrumentVersionId], references: [organizationId, id, instrumentVersionId], onDelete: Restrict)
  answers ResponseAnswer[]
  @@unique([id, instrumentVersionId])
  @@index([organizationId, cycleId, instrumentVersionId])
  @@map("diagnostic_responses")
}

model ResponseAnswer {
  id String @id @default(uuid()) @db.Uuid
  responseId String @map("response_id") @db.Uuid
  instrumentVersionId String @map("instrument_version_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  optionIds Json @map("option_ids")
  response DiagnosticResponse @relation(fields: [responseId, instrumentVersionId], references: [id, instrumentVersionId], onDelete: Restrict)
  question DiagnosticQuestion @relation(fields: [instrumentVersionId, questionId], references: [instrumentVersionId, id], onDelete: Restrict)
  @@unique([responseId, questionId])
  @@index([responseId, instrumentVersionId])
  @@index([instrumentVersionId, questionId])
  @@map("response_answers")
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  action String @db.VarChar(80)
  resourceId String? @map("resource_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  @@index([organizationId, createdAt])
  @@map("audit_events")
}

enum RiskStatus {
  DRAFT
  REGISTERED
  ARCHIVED
}

enum RiskSourceKind {
  DIAGNOSTIC_CYCLE
  TECHNICAL_RECORD
}

model Risk {
  riskReassessments RiskReassessment[] @relation("RiskReassessmentRisk")
  reassessmentMeasures ReassessmentMeasure[] @relation("ReassessmentMeasureRisk")
  actionTechnicalClosures ActionTechnicalClosure[] @relation("ActionTechnicalClosureRisk")
  actionCorrectiveLinks ActionCorrectiveLink[] @relation("ActionCorrectiveLinkRisk")
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  assessmentGroupId String @map("assessment_group_id") @db.Uuid
  factor String @db.VarChar(160)
  description String? @db.VarChar(2000)
  exposureDescription String? @map("exposure_description") @db.VarChar(2000)
  exposedGroupDescription String? @map("exposed_group_description") @db.VarChar(2000)
  possibleHarms String? @map("possible_harms") @db.VarChar(2000)
  existingControls String? @map("existing_controls") @db.VarChar(2000)
  sourceKind RiskSourceKind? @map("source_kind")
  sourceNote String? @map("source_note") @db.VarChar(1000)
  diagnosticCycleId String? @map("diagnostic_cycle_id") @db.Uuid
  status RiskStatus @default(DRAFT)
  version Int @default(1)
  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assessmentGroup AssessmentGroup @relation(fields: [organizationId, assessmentGroupId], references: [organizationId, id], onDelete: Restrict, map: "risks_group_fkey")
  diagnosticCycle DiagnosticCycle? @relation(fields: [organizationId, diagnosticCycleId], references: [organizationId, id], onDelete: Restrict, map: "risks_cycle_fkey")
  createdBy User @relation("RiskCreator", fields: [createdById], references: [id], onDelete: Restrict, map: "risks_creator_fkey")
  updatedBy User @relation("RiskUpdater", fields: [updatedById], references: [id], onDelete: Restrict, map: "risks_updater_fkey")
  evaluations RiskEvaluation[]
  technicalEvaluations TechnicalRiskEvaluation[]
  actions Action[]
  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt, id])
  actionEfficacyOpinions ActionEfficacyOpinion[]
  @@index([organizationId, assessmentGroupId])
  @@index([organizationId, diagnosticCycleId])
  @@map("risks")
}

model RiskEvaluation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  riskId String @map("risk_id") @db.Uuid
  sequence Int
  riskVersion Int @map("risk_version")
  contextSnapshot Json @map("context_snapshot")
  label String @default("PRELIMINARY") @db.VarChar(20)
  methodReference String @map("method_reference") @db.VarChar(200)
  methodVersion String @map("method_version") @db.VarChar(40)
  observation String @db.VarChar(2000)
  rationale String @db.VarChar(2000)
  authorId String @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "risk_evaluations_org_fkey")
  risk Risk @relation(fields: [organizationId, riskId], references: [organizationId, id], onDelete: Restrict, map: "risk_evaluations_risk_fkey")
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict, map: "risk_evaluations_author_fkey")
  actions Action[]
  @@unique([organizationId, riskId, id])
  @@unique([riskId, sequence])
  @@index([organizationId, riskId])
  @@map("risk_evaluations")
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  IMPLEMENTED
  CANCELLED
}

model Action {
  uploadAttempts EvidenceUploadAttempt[]
  reassessmentMeasures ReassessmentMeasure[] @relation("ReassessmentMeasureAction")
  actionTechnicalClosures ActionTechnicalClosure[] @relation("ActionTechnicalClosureAction")
  correctiveLinks ActionCorrectiveLink[] @relation("ActionCorrectiveLinkPreviousAction")
  originCorrectiveLinks ActionCorrectiveLink[] @relation("ActionCorrectiveLinkNewAction")
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  riskId String @map("risk_id") @db.Uuid
  evaluationId String? @map("evaluation_id") @db.Uuid
  sourceRiskVersion Int @map("source_risk_version")
  contextSnapshot Json @map("context_snapshot")
  title String @db.VarChar(160)
  description String @db.VarChar(2000)
  responsibleName String @map("responsible_name") @db.VarChar(120)
  assignedUserId String? @map("assigned_user_id") @db.Uuid
  assignedName String? @map("assigned_name") @db.VarChar(120)
  dueDate DateTime @map("due_date") @db.Date
  expectedResult String @map("expected_result") @db.VarChar(2000)
  verificationCriterion String @map("verification_criterion") @db.VarChar(2000)
  status ActionStatus @default(PLANNED)
  version Int @default(1)
  implementationNote String? @map("implementation_note") @db.VarChar(2000)
  implementedAt DateTime? @map("implemented_at")
  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  risk Risk @relation(fields: [organizationId, riskId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  evaluation RiskEvaluation? @relation(fields: [organizationId, riskId, evaluationId], references: [organizationId, riskId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy User @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedBy User @relation("ActionUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revisions ActionRevision[]
  assignedMembership Membership? @relation(fields: [assignedUserId, organizationId], references: [userId, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "actions_assigned_membership_fkey")
  evidence ActionEvidence[]
  efficacyOpinions ActionEfficacyOpinion[]
  @@unique([organizationId, id])
  @@index([organizationId, riskId])
  @@index([organizationId, status, dueDate, id])
  @@index([organizationId, assignedUserId, status, dueDate, id], map: "actions_org_assignee_status_due_id_idx")
  @@map("actions")
}

model ActionRevision {
  reassessmentMeasures ReassessmentMeasure[] @relation("ReassessmentMeasureRevision")
  actionTechnicalClosures ActionTechnicalClosure[] @relation("ActionTechnicalClosureRevision")
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actionId String @map("action_id") @db.Uuid
  version Int
  event String @db.VarChar(32)
  snapshot Json
  assignmentChange Json? @map("assignment_change")
  changeReason String? @map("change_reason") @db.VarChar(1000)
  text String? @db.VarChar(2000)
  evidenceId String? @map("evidence_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  action Action @relation(fields: [organizationId, actionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  evidence ActionEvidence? @relation(fields: [organizationId, actionId, evidenceId], references: [organizationId, actionId, id], onDelete: Restrict, onUpdate: NoAction)
  efficacyOpinions ActionEfficacyOpinion[]
  @@unique([actionId, version])
  @@map("action_revisions")
}

model ActionEfficacyOpinion {
  reassessmentMeasures ReassessmentMeasure[] @relation("ReassessmentMeasureOpinion")
  actionTechnicalClosures ActionTechnicalClosure[] @relation("ActionTechnicalClosureOpinion")
  correctiveLinks ActionCorrectiveLink[] @relation("ActionCorrectiveLinkOpinion")
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  actionId String @map("action_id") @db.Uuid
  riskId String @map("risk_id") @db.Uuid
  sequence Int
  supersedesId String? @unique @map("supersedes_id") @db.Uuid
  actionVersion Int @map("action_version")
  actionSnapshot Json @map("action_snapshot")
  riskContextSnapshot Json @map("risk_context_snapshot")
  actionFingerprint String @map("action_fingerprint") @db.VarChar(64)
  riskContextFingerprint String @map("risk_context_fingerprint") @db.VarChar(64)
  contextFingerprint String @map("context_fingerprint") @db.VarChar(64)
  criterionReference String @map("criterion_reference") @db.VarChar(2000)
  result String @db.VarChar(24)
  verifiedOn DateTime @map("verified_on") @db.Date
  observation String @db.VarChar(4000)
  rationale String @db.VarChar(4000)
  nextSteps String? @map("next_steps") @db.VarChar(2000)
  proofPackage Json @map("proof_package")
  authorId String @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  action Action @relation(fields: [organizationId, actionId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
