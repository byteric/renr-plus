NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://renr:CHANGE_ME@127.0.0.1:5432/renr?schema=public
# Production requires HTTPS CORS_ORIGIN and the compiled frontend directory.
SERVE_WEB=false
# WEB_DIST_PATH=/app/apps/web/dist
# Storage is unused in v0.1; enabling it requires both S3 credentials.
STORAGE_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=renr-evidence
S3_ACCESS_KEY=renr_local
S3_SECRET_KEY=CHANGE_ME
# Only local synthetic demo seeding; setup:local generates a random value.
DEMO_PASSWORD=CHANGE_ME_WITH_AT_LEAST_16_RANDOM_CHARACTERS
